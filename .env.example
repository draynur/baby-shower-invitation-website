# Cloudflare Turnstile
# Create a widget at dash.cloudflare.com → Turnstile. Use "Invisible" or "Managed" mode.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Sheets Integration
# Create a service account in Google Cloud Console and share the spreadsheet with it.

# The service account's email address (e.g. my-account@my-project.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private key — copy the full key including -----BEGIN/END----- lines,
# replacing literal newlines with \n so it fits on one line in .env / Vercel env vars.
GOOGLE_PRIVATE_KEY=

# The spreadsheet ID from the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=
